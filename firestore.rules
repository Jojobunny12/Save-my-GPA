rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check probe document for startup connection verification
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Shared primitive helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 6 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 4 && code.matches('^[A-Z]{4}$');
    }

    function isValidTier(tier) {
      return tier in ['Bronze', 'Silver', 'Gold', 'Platinum', 'Diamond', 'Grand Gbozz'];
    }

    // Validation Blueprint: StudyRoom (2D Battle Royale)
    function isValidStudyRoom(data, roomCode) {
      return data.keys().hasAll([
          'roomCode', 'hostId', 'hostName', 'title', 'status',
          'targetPlayers', 'countdownEndsAtMs', 'matchStartedAtMs',
          'arenaSeed', 'questions', 'winnerId', 'winnerName',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'roomCode', 'hostId', 'hostName', 'title', 'status',
          'targetPlayers', 'countdownEndsAtMs', 'matchStartedAtMs',
          'arenaSeed', 'questions', 'winnerId', 'winnerName',
          'createdAt', 'updatedAt'
        ])
        && data.roomCode == roomCode
        && isValidRoomCode(data.roomCode)
        && isValidId(data.hostId)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 32
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.status in ['lobby', 'active', 'finished']
        && data.targetPlayers is int && data.targetPlayers >= 2 && data.targetPlayers <= 20
        && data.countdownEndsAtMs is number && data.countdownEndsAtMs >= 0
        && data.matchStartedAtMs is number && data.matchStartedAtMs >= 0
        && data.arenaSeed is int && data.arenaSeed >= 0
        && data.questions is list
        && data.questions.size() >= 1
        && data.questions.size() <= 50
        && data.questions[0] is map
        && data.questions[0].question is string
        && data.questions[0].options is list
        && data.winnerId is string && data.winnerId.size() <= 64
        && data.winnerName is string && data.winnerName.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: StudyPlayer (Live Top-Down Bozz Battles State)
    function isValidStudyPlayer(data, playerId) {
      return data.keys().hasAll([
          'playerId', 'displayName', 'mmr', 'tier', 'isHost',
          'alive', 'hp', 'shield', 'ammo', 'kills', 'hasMedallion',
          'questionsCorrect', 'questionsAttempted', 'x', 'y', 'aimAngle',
          'exposedUntilMs', 'placement',
          'lastShotId', 'lastShotX', 'lastShotY', 'lastShotVx', 'lastShotVy', 'lastShotAtMs',
          'joinedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'playerId', 'displayName', 'mmr', 'tier', 'isHost',
          'alive', 'hp', 'shield', 'ammo', 'kills', 'hasMedallion',
          'questionsCorrect', 'questionsAttempted', 'x', 'y', 'aimAngle',
          'exposedUntilMs', 'placement',
          'lastShotId', 'lastShotX', 'lastShotY', 'lastShotVx', 'lastShotVy', 'lastShotAtMs',
          'joinedAt', 'updatedAt'
        ])
        && data.playerId == playerId
        && isValidId(data.playerId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 24
        && data.mmr is int && data.mmr >= 0 && data.mmr <= 5000
        && isValidTier(data.tier)
        && data.isHost is bool
        && data.alive is bool
        && data.hp is int && data.hp >= 0 && data.hp <= 100
        && data.shield is int && data.shield >= 0 && data.shield <= 100
        && data.ammo is int && data.ammo >= 0 && data.ammo <= 500
        && data.kills is int && data.kills >= 0 && data.kills <= 50
        && data.hasMedallion is bool
        && data.questionsCorrect is int && data.questionsCorrect >= 0 && data.questionsCorrect <= 200
        && data.questionsAttempted is int && data.questionsAttempted >= 0 && data.questionsAttempted <= 200
        && data.x is number && data.x >= 0 && data.x <= 2400
        && data.y is number && data.y >= 0 && data.y <= 2400
        && data.aimAngle is number
        && data.exposedUntilMs is number && data.exposedUntilMs >= 0
        && data.placement is int && data.placement >= 0 && data.placement <= 20
        && data.lastShotId is string && data.lastShotId.size() <= 48
        && data.lastShotX is number
        && data.lastShotY is number
        && data.lastShotVx is number
        && data.lastShotVy is number
        && data.lastShotAtMs is number && data.lastShotAtMs >= 0
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: StudyWorldState (Bots, Mini-Bozzes, Firewalls, Crates, KillFeed)
    function isValidWorldState(data) {
      return data.keys().hasAll(['bots', 'miniBozzes', 'firewalls', 'crateStates', 'killFeed', 'updatedAt'])
        && data.keys().hasOnly(['bots', 'miniBozzes', 'firewalls', 'crateStates', 'killFeed', 'updatedAt'])
        && data.bots is list && data.bots.size() <= 20
        && data.miniBozzes is list && data.miniBozzes.size() <= 4
        && data.firewalls is list && data.firewalls.size() <= 24
        && data.crateStates is list && data.crateStates.size() <= 60
        && data.killFeed is list && data.killFeed.size() <= 10
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: BattleProfile (Competitive ELO/MMR Rank)
    function isValidBattleProfile(data, profileId) {
      return data.keys().hasAll([
          'profileId', 'displayName', 'mmr', 'peakMmr', 'tier',
          'matchesPlayed', 'wins', 'totalKills',
          'questionsCorrect', 'questionsAttempted',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'profileId', 'displayName', 'mmr', 'peakMmr', 'tier',
          'matchesPlayed', 'wins', 'totalKills',
          'questionsCorrect', 'questionsAttempted',
          'createdAt', 'updatedAt'
        ])
        && data.profileId == profileId
        && isValidId(data.profileId)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 24
        && data.mmr is int && data.mmr >= 0 && data.mmr <= 5000
        && data.peakMmr is int && data.peakMmr >= 0 && data.peakMmr <= 5000
        && isValidTier(data.tier)
        && data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 100000
        && data.wins is int && data.wins >= 0 && data.wins <= 100000
        && data.totalKills is int && data.totalKills >= 0 && data.totalKills <= 1000000
        && data.questionsCorrect is int && data.questionsCorrect >= 0 && data.questionsCorrect <= 1000000
        && data.questionsAttempted is int && data.questionsAttempted >= 0 && data.questionsAttempted <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /studyRooms/{roomCode} {
      allow get: if isValidRoomCode(roomCode);
      allow list: if false;

      allow create: if isValidRoomCode(roomCode)
        && isValidStudyRoom(incoming(), roomCode)
        && incoming().status == 'lobby'
        && incoming().winnerId == ''
        && incoming().winnerName == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidRoomCode(roomCode)
        && isValidStudyRoom(incoming(), roomCode)
        && incoming().roomCode == existing().roomCode
        && incoming().hostId == existing().hostId
        && incoming().hostName == existing().hostName
        && incoming().title == existing().title
        && incoming().questions == existing().questions
        && incoming().targetPlayers == existing().targetPlayers
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Extend or reset lobby countdown before start
          (
            existing().status == 'lobby'
            && incoming().status == 'lobby'
            && incoming().arenaSeed == existing().arenaSeed
            && incoming().diff(existing()).affectedKeys().hasOnly(['countdownEndsAtMs', 'updatedAt'])
          )
          ||
          // Action: Launch active Battle Royale match from lobby
          (
            existing().status == 'lobby'
            && incoming().status == 'active'
            && incoming().arenaSeed == existing().arenaSeed
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'matchStartedAtMs', 'updatedAt'])
          )
          ||
          // Action: Conclude Battle Royale match and record winner
          (
            existing().status == 'active'
            && incoming().status == 'finished'
            && incoming().arenaSeed == existing().arenaSeed
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'winnerId', 'winnerName', 'updatedAt'])
          )
          ||
          // Action: Host requeues finished room back to open lobby (same roomCode)
          (
            existing().status == 'finished'
            && incoming().status == 'lobby'
            && incoming().winnerId == ''
            && incoming().winnerName == ''
            && incoming().matchStartedAtMs == 0
            && incoming().countdownEndsAtMs == 0
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winnerId', 'winnerName', 'matchStartedAtMs', 'countdownEndsAtMs', 'arenaSeed', 'updatedAt'
            ])
          )
          ||
          // Action: Host quick-requeues finished room directly into a new active match (same roomCode)
          (
            existing().status == 'finished'
            && incoming().status == 'active'
            && incoming().winnerId == ''
            && incoming().winnerName == ''
            && incoming().matchStartedAtMs > 0
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'winnerId', 'winnerName', 'matchStartedAtMs', 'arenaSeed', 'updatedAt'
            ])
          )
        );

      allow delete: if false;

      match /players/{playerId} {
        allow get, list: if isValidRoomCode(roomCode);

        allow create: if isValidRoomCode(roomCode)
          && isValidId(playerId)
          && isValidStudyPlayer(incoming(), playerId)
          && incoming().hp == 100
          && incoming().kills == 0
          && incoming().alive == true
          && incoming().placement == 0
          && incoming().joinedAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/studyRooms/$(roomCode))
          && get(/databases/$(database)/documents/studyRooms/$(roomCode)).data.status == 'lobby';

        allow update: if isValidRoomCode(roomCode)
          && isValidId(playerId)
          && isValidStudyPlayer(incoming(), playerId)
          && incoming().playerId == existing().playerId
          && incoming().displayName == existing().displayName
          && incoming().isHost == existing().isHost
          && incoming().joinedAt == existing().joinedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'alive', 'hp', 'shield', 'ammo', 'kills', 'hasMedallion',
            'questionsCorrect', 'questionsAttempted', 'x', 'y', 'aimAngle',
            'exposedUntilMs', 'placement',
            'lastShotId', 'lastShotX', 'lastShotY', 'lastShotVx', 'lastShotVy', 'lastShotAtMs',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/studyRooms/$(roomCode))
          && getAfter(/databases/$(database)/documents/studyRooms/$(roomCode)).data.status != 'finished';

        allow delete: if false;
      }

      match /world/{docId} {
        allow get: if isValidRoomCode(roomCode) && docId == 'state';
        allow list: if false;

        allow create, update: if isValidRoomCode(roomCode)
          && docId == 'state'
          && isValidWorldState(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/studyRooms/$(roomCode))
          && getAfter(/databases/$(database)/documents/studyRooms/$(roomCode)).data.status != 'finished';

        allow delete: if false;
      }
    }

    match /battleProfiles/{profileId} {
      allow get: if isValidId(profileId);
      allow list: if false;

      allow create: if isValidId(profileId)
        && isValidBattleProfile(incoming(), profileId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(profileId)
        && isValidBattleProfile(incoming(), profileId)
        && incoming().profileId == existing().profileId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'mmr', 'peakMmr', 'tier',
          'matchesPlayed', 'wins', 'totalKills',
          'questionsCorrect', 'questionsAttempted', 'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
